{
  "name": "clock-app",
  "version": "1.1.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "codegen:starry": "openapi-typescript ../../contracts/starry-id.v1.json -o ../../packages/auth-client-contract/src/generated/starry-id.d.ts"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-router": "~58.0.30",
    "expo-audio": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.0",
    "react-dom": "19.3.0",
    "@clock/core": "workspace:*",
    "@clock/auth-contract": "workspace:*",
    "expo-web-browser": "~58.0.7",
    "expo-crypto": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "react-native-passkeys": "0.4.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3",
    "openapi-typescript": "7.13.0"
  }
