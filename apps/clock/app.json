{
  "expo": {
    "name": "Clock繁星計時器",
    "slug": "clock",
    "scheme": "clock",
    "version": "1.1.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "phd.starry.clock",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "buildNumber": "1",
      "associatedDomains": [
        "webcredentials:id.starry.phd"
      ]
    },
    "android": {
      "package": "phd.starry.clock",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "appId": "clock",
      "brandId": "starry",
      "apiBase": "https://id.starry.phd",
      "adsEnabled": false,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd610a4d-aa22-48b1-9bdc-fae3c8cab64f"
      },
      "starryRelayRedirects": [
        "clock://auth/apple",
        "clock://auth/google",
        "https://clock.starry.phd/auth/done"
      ]
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B1220",
    "owner": "starryphd"
  }
}
