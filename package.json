{
  "name": "clock",
  "private": true,
  "version": "1.1.1",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "test:clock": "node --test packages/clock-core/test/clock.test.mjs",
    "typecheck": "pnpm codegen:starry && pnpm --dir apps/clock exec tsc --noEmit",
    "web": "pnpm --dir apps/clock web",
    "codegen:starry": "pnpm --dir apps/clock codegen:starry",
    "postinstall": "pnpm codegen:starry"
  }
}
